## Q4. Class `Book` — Constructor and Destructor

```cpp
#include <iostream>
using namespace std;

class Book {
private:
    string title;
    float price;
public:
    // Constructor
    Book(string t, float p) {
        title = t;
        price = p;
        cout << "Book created: " << title << endl;
    }

    void display() {
        cout << "Title: " << title << endl;
        cout << "Price: " << price << endl;
    }

    // Destructor
    ~Book() {
        cout << "Book destroyed: " << title << endl;
    }
};

int main() {
    Book b("C++ Basics", 350.50);
    b.display();
    return 0;
}
```

**Output:**
```
Book created: C++ Basics
Title: C++ Basics
Price: 350.5
Book destroyed: C++ Basics
```
