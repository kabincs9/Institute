## Q1. Friend Function `calculateArea()` — Rectangle and Triangle

```cpp
#include <iostream>
using namespace std;

class Triangle; // forward declaration

class Rectangle {
    int length, breadth;
public:
    Rectangle(int l, int b) {
        length = l;
        breadth = b;
    }
    friend void calculateArea(Rectangle r, Triangle t);
};

class Triangle {
    int base, height;
public:
    Triangle(int b, int h) {
        base = b;
        height = h;
    }
    friend void calculateArea(Rectangle r, Triangle t);
};

void calculateArea(Rectangle r, Triangle t) {
    int rectArea = r.length * r.breadth;
    float triArea = 0.5 * t.base * t.height;
    cout << "Area of Rectangle: " << rectArea << endl;
    cout << "Area of Triangle: " << triArea << endl;
}

int main() {
    Rectangle r(5, 4);
    Triangle t(6, 8);
    calculateArea(r, t);
    return 0;
}
```

**Output:**
```
Area of Rectangle: 20
Area of Triangle: 24
```

